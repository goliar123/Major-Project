# LLM Provider Configuration
# Switch between "mock" (offline heuristic) and "ollama" (local llama3.2 model)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:latest
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.0

# Caching & Storage Settings (Deterministic SHA256 Caching)
CACHE_ENABLED=true
CACHE_BACKEND=sqlite
DEBUG=true
